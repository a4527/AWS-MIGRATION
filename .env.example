POSTGRES_DB=fileshare
POSTGRES_USER=fileshare
POSTGRES_PASSWORD=fileshare
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=files
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

NGINX_PORT=8080

APP_JWT_SECRET=change-this-secret-before-production
APP_JWT_EXPIRES_IN_SECONDS=3600
APP_FILE_MAX_SIZE_BYTES=10485760
APP_FILE_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,csv

# 업로드 멱등성·재시도 (ISO-8601 기간). 장애 검증 시 처리 중 판단 기준을 PT1M 등으로 줄일 수 있다.
APP_FILE_IDEMPOTENCY_TTL=PT24H
APP_FILE_IDEMPOTENCY_IN_PROGRESS_TIMEOUT=PT15M
APP_FILE_UPLOAD_RECORD_ATTEMPTS=3
