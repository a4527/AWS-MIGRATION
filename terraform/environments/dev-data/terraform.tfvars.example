aws_region   = "us-east-1"
# Required. Every resource gets this Owner tag; untagged resources may be deleted.
owner        = "replace-with-owner-id"
project_name = "fileshare"
environment  = "dev"

vpc_cidr           = "10.20.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]
public_subnets     = ["10.20.0.0/24", "10.20.1.0/24"]
private_subnets    = ["10.20.10.0/24", "10.20.11.0/24"]
database_subnets   = ["10.20.20.0/24", "10.20.21.0/24"]

file_bucket_name      = "replace-with-globally-unique-fileshare-dev-bucket"
force_destroy_buckets = false

# The Aurora master password is generated by Terraform and stored in SSM
# (SEC-01). Increase this number to rotate it.
aurora_master_password_version = 1

# 0 ACU = compute paused while idle; only storage is billed.
aurora_min_capacity             = 0
aurora_max_capacity             = 2
aurora_seconds_until_auto_pause = 300
aurora_deletion_protection      = true
aurora_skip_final_snapshot      = false

# CD (DEC-015). The deploy role trusts only this repository and branch.
github_repository = "replace-with-github-owner/aws-migration-project"
github_branch     = "main"

# Monthly budget (PORT-01). Put real addresses only in terraform.tfvars.
budget_limit_usd           = 10
budget_alert_emails        = ["replace-with-alert-email@example.com"]
budget_filter_by_owner_tag = true

# Extra tags. Do not set Owner here; var.owner always wins.
tags = {}

# IAC-03: state bucket from terraform/bootstrap output state_bucket_name.
terraform_state_bucket_name = "replace-with-terraform-state-bucket"

